; Script generated by Antigravity for Bike Shop Manager

[Setup]
; Basic Application Information
AppName=Bike Shop Manager
AppVersion=1.0
AppPublisher=Alaa
DefaultDirName={autopf}\BikeShopManager
DefaultGroupName=Bike Shop Manager
; Output folder for the setup file
OutputDir=.
OutputBaseFilename=BikeShopManager_Setup
; Icon for the setup file (optional, uses default if not specified)
; SetupIconFile=icon.ico
Compression=lzma
SolidCompression=yes
; Require Admin privileges to install to Program Files
PrivilegesRequired=admin

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; The main executable from PyInstaller dist folder
Source: "dist\BikeShopManager.exe"; DestDir: "{app}"; Flags: ignoreversion
; You can include the database locally if you want a fresh empty one, 
; but typically the app creates it if missing. 
; To include a ready-made DB, uncomment the next line:
; Source: "bike_shop.db"; DestDir: "{app}"; Flags: ignoreversion onlyifdoesntexist

[Icons]
Name: "{group}\Bike Shop Manager"; Filename: "{app}\BikeShopManager.exe"
Name: "{commondesktop}\Bike Shop Manager"; Filename: "{app}\BikeShopManager.exe"; Tasks: desktopicon

[Run]
Filename: "{app}\BikeShopManager.exe"; Description: "{cm:LaunchProgram,Bike Shop Manager}"; Flags: nowait postinstall skipifsilent
